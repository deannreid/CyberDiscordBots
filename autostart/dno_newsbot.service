[Unit]
Description=Bot to grab latest newss 
After=network.target

[Service]
User=reidde
WorkingDirectory=/home/reidde/DiscordBots
ExecStart=/usr/bin/python3 /home/reidde/DiscordBots/cveNews.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
